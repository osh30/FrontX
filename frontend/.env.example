# Backend API (Frontend base URL for all API requests)
VITE_API_URL=https://frontx-backend.onrender.com

# Backend Socket.IO (used for chat, notifications, live activity)
VITE_SOCKET_URL=https://frontx-backend.onrender.com

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# LiveKit (FrontX Meeting Platform)
VITE_LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
